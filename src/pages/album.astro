---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { Image } from "astro:assets";

// 影集 — 按时间流的单列长卷轴。
//
// 加照片（三步）：
//   1. 原图放进 src/assets/photos/（建议命名 年份-地点.jpeg），不要放 public/。
//   2. 在下方 import。
//   3. 在 photos 数组【最上方】加一条（数组按新 → 旧排列）。
//   year 变化时年份分隔线自动出现；note 可省略。

import viaductSkyline from "../assets/photos/2026-shanghai-viaduct-skyline.jpeg";
import interchange from "../assets/photos/2026-shanghai-interchange.jpeg";
import mallAtrium from "../assets/photos/2026-shanghai-mall-atrium.jpeg";
import glassFacade from "../assets/photos/2026-shanghai-glass-facade.jpeg";
import orientalPearl from "../assets/photos/2026-shanghai-oriental-pearl.jpeg";
import photoExhibition from "../assets/photos/2026-shanghai-photo-exhibition.jpeg";
import towerCrane from "../assets/photos/2026-shanghai-tower-crane.jpeg";

type Photo = {
  src: ImageMetadata;
  alt: string;
  caption: string;
  note?: string;
  year: string;
};

const photos: Photo[] = [
  {
    src: viaductSkyline,
    alt: "高架路俯瞰上海城区，在建高楼、老城屋顶与远处天际线连成一片",
    caption: "上海 · 二〇二六年七月六日",
    note: "从高处望下去，脚手架、高架与旧屋顶挤在同一帧里。",
    year: "二〇二六",
  },
  {
    src: interchange,
    alt: "高架路口，「浙江北路」「新建路」绿色路牌下车流穿行，一旁是在建工地",
    caption: "浙江北路口 · 上海 · 二〇二六年七月六日",
    year: "二〇二六",
  },
  {
    src: mallAtrium,
    alt: "商场中庭俯拍，咖啡区人群三三两两，动漫联名展的横幅垂下",
    caption: "商场中庭 · 上海 · 二〇二六年七月六日",
    note: "各坐各的下午，头顶垂着别人的热闹。",
    year: "二〇二六",
  },
  {
    src: glassFacade,
    alt: "隔着玻璃幕墙的钢桁架，望向楼下街道与对面的老公房",
    caption: "玻璃幕墙内 · 上海 · 二〇二六年七月六日",
    year: "二〇二六",
  },
  {
    src: orientalPearl,
    alt: "街道尽头，梧桐树梢与高楼之间露出东方明珠的球体",
    caption: "街的尽头 · 上海 · 二〇二六年七月六日",
    note: "树缝里，塔尖忽然探出来。",
    year: "二〇二六",
  },
  {
    src: photoExhibition,
    alt: "摄影展圆窗里，举着相机的自拍叠在一张持相机的旧照片上",
    caption: "摄影展 · 上海 · 二〇二六年七月六日",
    note: "隔着一个圆，和几十年前的快门对上了眼。",
    year: "二〇二六",
  },
  {
    src: towerCrane,
    alt: "仰拍黄色塔吊的臂架，横过一角蓝天，下方是绿色围挡",
    caption: "工地上空 · 上海 · 二〇二六年七月六日",
    year: "二〇二六",
  },
];

const yearOf = (i: number) => photos[i].year;
---

<Layout title="影集" description="路上所见，随手所摄。">
  <Container>
    <div class="space-y-10">
      <div class="animate space-y-3">
        <div class="text-xs font-semibold tracking-[0.1em] text-black/75 dark:text-white/60">
          Album · 影
        </div>
        <h1 class="text-2xl font-normal text-black dark:text-white">影集</h1>
        <p class="text-black/75 dark:text-white/60">路上所见，随手所摄。</p>
      </div>

      {
        photos.length > 0 ? (
          <div class="space-y-16">
            {photos.map((photo, i) => (
              <>
                {(i === 0 || yearOf(i) !== yearOf(i - 1)) && (
                  <div class="animate flex items-center gap-4 pt-4">
                    <span class="text-xs font-semibold tracking-[0.1em] text-black/75 dark:text-white/60">
                      {photo.year}
                    </span>
                    <span
                      class="h-px flex-1 bg-black/10 dark:bg-white/15"
                      aria-hidden="true"
                    />
                  </div>
                )}
                <figure class="animate m-0">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={1344}
                    class="w-full rounded-md border border-black/10 dark:border-white/15"
                  />
                  <figcaption class="mt-4 space-y-1.5">
                    <div class="text-xs font-semibold tracking-[0.1em] text-black/75 dark:text-white/60">
                      {photo.caption}
                    </div>
                    {photo.note && (
                      <div class="max-w-xl text-sm leading-[1.9] text-black/75 dark:text-white/60">
                        {photo.note}
                      </div>
                    )}
                  </figcaption>
                </figure>
              </>
            ))}
          </div>
        ) : (
          <div class="animate rounded-md border border-dashed border-black/15 py-16 text-center dark:border-white/15">
            <div class="text-black/75 dark:text-white/60">暂无照片</div>
            <div class="mt-2 text-sm text-black/50 dark:text-white/40">
              照片会慢慢添上。
            </div>
          </div>
        )
      }

      <div
        class="animate pt-8 text-center text-black/75 dark:text-white/60"
        aria-hidden="true"
      >
        ⁂
      </div>
    </div>
  </Container>
</Layout>
