---
// album/index.astro — 影集列表页
// 抬头（影集 + 一句话）→ 筛选行（全部/胶卷/主题/散拍）
// → 一贴一条的时间流：左边眉标 + 标题 + 一句话，右边一排小缩略图（与文字块等高）。
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const albums = (await getCollection("albums"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = albums[0];

const fmt = (d: Date) => `${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
const kicker = (a: (typeof albums)[number]) => {
  const d = a.data;
  if (d.kind === "roll") return [d.roll, d.film].filter(Boolean).join(" · ");
  if (d.kind === "theme") return "主题";
  return `${fmt(d.date)} · 散拍`;
};
---

<Layout title="影集" description="冲完一卷，或攒够一个念头，发一贴。">
  <Container>
    {
      latest && (
        <div class="album-door animate" data-pagefind-ignore>
          <a class="door-strip" href={`/album/${latest.id}`}>
            {latest.data.photos.slice(0, 6).map((p) => (
              <Image src={p.src} alt={p.alt} width={640} loading="eager" class="door-img" />
            ))}
          </a>
          <div class="door-cap">
            <span class="door-kicker">
              <b>{kicker(latest)}</b> · {latest.data.title}
            </span>
            <a class="door-enter" href={`/album/${latest.id}`}>进入此贴 →</a>
          </div>
        </div>
      )
    }

    <div class="album-head animate">
      <h1 class="album-title">影集</h1>
      <p class="album-sub">冲完一卷，或攒够一个念头，发一贴。</p>
      <div class="album-filter" role="group" aria-label="按来源筛选">
        <button class="filter-btn is-on" data-filter="all">全部</button>
        <button class="filter-btn" data-filter="roll">胶卷</button>
        <button class="filter-btn" data-filter="theme">主题</button>
        <button class="filter-btn" data-filter="casual">散拍</button>
      </div>
    </div>

    <div class="album-feed">
      {
        albums.map((a) => (
          <article class="album-entry animate" data-kind={a.data.kind}>
            <div class="entry-text">
              <div class="entry-head">
                <span class:list={["entry-kicker", { "is-roll": a.data.kind === "roll" }]}>{kicker(a)}</span>
                <span class="entry-meta">
                  {a.data.kind === "roll" ? `${fmt(a.data.date)}冲扫 · ` : ""}
                  {a.data.photos.length} 张
                </span>
              </div>
              <a class="entry-title" href={`/album/${a.id}`}>{a.data.title}</a>
              {a.data.note && <p class="entry-note">{a.data.note}</p>}
            </div>
            <a class="entry-strip" href={`/album/${a.id}`} aria-label={`${a.data.title} · 进入`}>
              {a.data.photos.slice(0, 3).map((p) => (
                <Image src={p.src} alt={p.alt} width={280} loading="lazy" class="entry-img" />
              ))}
              {a.data.photos.length > 3 && <span class="entry-more">+{a.data.photos.length - 3}</span>}
            </a>
          </article>
        ))
      }
      <p class="album-empty" hidden>这一类还没有贴。</p>
    </div>

    <div aria-hidden="true" class="album-dinkus">⁂</div>
  </Container>
</Layout>

<script>
  // 筛选：纯前端显隐，无路由
  const btns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const entries = document.querySelectorAll<HTMLElement>(".album-entry");
  const empty = document.querySelector<HTMLElement>(".album-empty");
  btns.forEach((b) =>
    b.addEventListener("click", () => {
      btns.forEach((x) => x.classList.toggle("is-on", x === b));
      const f = b.dataset.filter;
      let shown = 0;
      entries.forEach((e) => {
        const on = f === "all" || e.dataset.kind === f;
        e.hidden = !on;
        if (on) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>

<style is:global>
  /* ===== 出血门头（最近一贴）=====
     只有印样条出血到视口两缘；眉标行留在版心内，不贴屏幕边。
     不用负 margin 上提，避免钻进固定导航底下。 */
  .door-strip {
    display: flex;
    gap: 2px;
    height: 250px;
    overflow: hidden;
    margin-inline: calc(50% - 50vw);
  }
  .door-img { flex: none; height: 100%; width: auto; display: block; }
  .door-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--text-strong, #353534) 8%, transparent);
  }
  .door-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--text-quiet, #6b6a64);
  }
  .door-kicker b { color: var(--accent, #b1462f); font-weight: 700; }
  .door-enter {
    font-size: 0.82rem;
    color: var(--text-body, #4a4944);
    text-decoration: none;
    transition: color 0.3s ease-in-out;
    white-space: nowrap;
  }
  .door-enter:hover { color: var(--accent, #b1462f); }

  /* ===== 页头 + 筛选 ===== */
  .album-head { padding-top: 2.5rem; }
  .album-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    font-family: var(--font-display, ui-serif, Georgia, serif);
    color: var(--text-strong, #353534);
  }
  .album-sub { margin: 1rem 0 0; font-size: 1rem; line-height: 1.9; color: var(--text-muted, #5a5852); }
  .album-filter { display: flex; gap: 1.5rem; margin-top: 2.25rem; }
  .filter-btn {
    background: none;
    border: none;
    padding: 0 0 2px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--text-body, #4a4944);
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease-in-out;
  }
  .filter-btn:hover { color: var(--accent, #b1462f); }
  .filter-btn.is-on {
    color: var(--text-strong, #353534);
    border-bottom-color: color-mix(in oklab, var(--text-strong, #353534) 25%, transparent);
  }

  /* ===== 贴流：左文右图，缩略图与文字块等高 ===== */
  .album-feed { display: flex; flex-direction: column; }
  .album-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid color-mix(in oklab, var(--text-strong, #353534) 8%, transparent);
  }
  .album-entry:first-of-type { margin-top: 2.5rem; border-top: 0; padding-top: 0; }
  .entry-text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }
  .entry-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; }
  .entry-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--text-quiet, #6b6a64);
  }
  .entry-kicker.is-roll { color: var(--accent, #b1462f); }
  .entry-meta { font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-quiet, #6b6a64); }
  .entry-title {
    font-size: 1.25rem;
    font-weight: 400;
    font-family: var(--font-display, ui-serif, Georgia, serif);
    color: var(--text-strong, #353534);
    text-decoration: none;
    transition: color 0.3s ease-in-out;
    align-self: flex-start;
  }
  .entry-title:hover { color: var(--accent, #b1462f); }
  /* 高度对齐右侧文字块：眉标 + 标题 + 一句话 ≈ 5.5rem */
  .entry-strip { display: flex; flex: none; gap: 0.5rem; height: 5.5rem; text-decoration: none; }
  .entry-img {
    flex: none;
    height: 100%;
    width: auto;
    display: block;
    border: 1px solid color-mix(in oklab, var(--text-strong, #353534) 10%, transparent);
    border-radius: 0.375rem;
  }
  .entry-more {
    flex: none;
    width: 3rem;
    height: 100%;
    border: 1px solid color-mix(in oklab, var(--text-strong, #353534) 10%, transparent);
    border-radius: 0.375rem;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-quiet, #6b6a64);
  }
  .entry-note {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.9;
    color: var(--text-muted, #5a5852);
    max-width: 32rem;
  }
  .album-empty { margin-top: 3rem; font-size: 0.9rem; color: var(--text-quiet, #6b6a64); }
  .album-dinkus { text-align: center; margin: 5rem 0 1rem; color: var(--text-quiet, #6b6a64); }

  @media (max-width: 760px) {
    .door-strip { height: 160px; }
  }
  @media (max-width: 640px) {
    .album-entry { flex-direction: column; align-items: stretch; }
    .entry-strip { height: 4.5rem; }
  }
</style>
